---
import event from '../data/event.json';
import { loteState, priceFor, brl, registrationUrl } from '../lib/lotes.js';
const st = loteState(event, new Date());
const p = priceFor(event, st, '5k');
---
<div class="sticky" data-sticky>
  <div class="txt">
    <span class="label" data-sticky-label>{st.kind === 'lote' ? st.lote.label : p.label}</span>
    <span class="mono price" data-sticky-price>{p.current != null ? `a partir de ${brl(p.current)}` : ''}</span>
  </div>
  <a class="btn btn-aqua" href={registrationUrl(event, 'sticky')} target="_blank" rel="noopener" data-cta="sticky">Inscreva-se</a>
</div>
<style>
  .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(253,251,247,.94); backdrop-filter: blur(10px); border-top: 1px solid var(--line);
            transform: translateY(100%); transition: transform .3s ease; }
  body.past-hero .sticky { transform: none; }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .price { font-size: 14px; font-weight: 600; white-space: nowrap; }
  .sticky .btn { min-height: 48px; padding: 10px 22px; font-size: 15px; flex: none; }
  @media (min-width: 820px) { .sticky { display: none; } }
</style>
