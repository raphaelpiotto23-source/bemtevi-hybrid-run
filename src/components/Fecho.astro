---
import event from '../data/event.json';
import { registrationUrl, whatsappUrl } from '../lib/lotes.js';
const wa = whatsappUrl(event, `Olá! Quero saber como ser patrocinador da ${event.name}, 29/11.`);
---
<section id="fecho" class="fecho sand">
  <div class="wrap content">
    <img class="bird" src="/img/passaro-640.png" width="160" height="244" alt="" loading="lazy" decoding="async" />
    <p class="eyebrow">29.11.2026 · Bem Te Vi · São João da Boa Vista</p>
    <h2>Seu pouso é aqui.</h2>
    <p class="lede">Chip, medalha e uma mesa esperando.</p>
    <a class="btn btn-aqua big" href={registrationUrl(event, 'fecho')} target="_blank" rel="noopener" data-cta="fecho">Inscreva-se</a>
  </div>
</section>

<section id="patrocinio" class="sec">
  <div class="wrap pat">
    <div class="sec-h reveal">
      <p class="eyebrow">Seja patrocinador</p>
      <h2>Sua marca na linha de chegada que ninguém abandona.</h2>
      <p class="lede">{event.sponsorPitch}</p>
    </div>
    <a class="btn btn-aqua reveal" href={wa} target="_blank" rel="noopener" data-cta="patrocinio">Chamar no WhatsApp</a>
  </div>
</section>
<style>
  .fecho { position: relative; min-height: min(80svh, 720px); display: grid; align-items: center; overflow: hidden; isolation: isolate; }
  .content { display: grid; gap: 18px; justify-items: start; padding-block: 96px; }
  .bird { width: 120px; height: auto; opacity: .9; }
  @media (min-width: 820px) { .fecho .bird { position: absolute; right: 8%; top: 50%; transform: translateY(-50%); width: 260px; opacity: .55; } }
  .big { min-height: 60px; padding: 14px 36px; font-size: 18px; }
  .pat .sec-h { margin-bottom: 24px; }
  @media (min-width: 820px) { .content { padding-block: 140px; } .bird { width: 160px; } }
</style>
