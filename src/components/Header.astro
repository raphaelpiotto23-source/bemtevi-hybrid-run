---
import event from '../data/event.json';
import { registrationUrl } from '../lib/lotes.js';
const nav = [['#ideia', 'A ideia'], ['#precos', 'Preços'], ['#percurso', 'Percurso'], ['#kit', 'Kit'], ['#programacao', 'Programação'], ['#faq', 'FAQ']];
---
<header class="top">
  <div class="wrap bar">
    <a href="#inicio" class="brand" aria-label="Bem Te Vi Hybrid Run, início da página">
      <img class="selo" src="/img/logo-corrida-160.png" width="36" height="36" alt="" />
      <span>{event.siteName}</span>
    </a>
    <nav class="menu" aria-label="Seções">
      {nav.map(([h, t]) => <a href={h}>{t}</a>)}
    </nav>
    <a class="btn btn-aqua cta" href={registrationUrl(event, 'header')} target="_blank" rel="noopener" data-cta="header">Inscreva-se</a>
  </div>
</header>
<style>
  .top { position: sticky; top: 0; z-index: 40; background: rgba(253, 251, 247, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .selo { width: 36px; height: 36px; border-radius: 50%; }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: -0.01em; text-decoration: none; font-size: 17px; }
  .menu { display: none; gap: 22px; margin-left: auto; font-size: 15px; font-weight: 400; }
  .menu a { text-decoration: none; color: var(--fg2); }
  .menu a:hover { color: var(--accent); }
  .cta { margin-left: auto; min-height: 44px; padding: 8px 18px; font-size: 14px; }
  @media (min-width: 820px) { .menu { display: flex; } .cta { margin-left: 0; } }
</style>
