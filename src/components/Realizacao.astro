---
import event from '../data/event.json';
---
<section id="realizacao" class="sec">
  <div class="wrap grid">
    <div class="sec-h reveal">
      <p class="eyebrow">Realização The Hybrid Club · Confraria Bem Te Vi</p>
      <h2>{event.tagline}</h2>
      <p class="lede">{event.support}</p>
    </div>
    <div class="sig reveal">
      <p class="label">{event.circuit} · {event.edition}</p>
      <p class="sig-t">{event.signature}</p>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; gap: 32px; }
  .sec-h { margin-bottom: 0; }
  .sig { display: grid; gap: 10px; align-content: end; }
  .sig-t { font-size: clamp(22px, 2.6vw, 32px); font-weight: 700; line-height: 1.25; max-width: 520px; }
  @media (min-width: 820px) { .grid { grid-template-columns: 1.2fr 1fr; align-items: end; gap: 64px; } }
</style>
