---
import event from '../data/event.json';
const logo = (x) => (x.logoNavy ? x.logoNavy : null);
const symbolOnly = (x) => /simbolo|Símbolo/.test(x.logoNote || '');
---
<section id="bando" class="sec">
  <div class="wrap">
    <div class="sec-h reveal">
      <p class="eyebrow">Quem está com a gente</p>
      <h2>O bando que faz a prova acontecer.</h2>
    </div>

    <p class="label reveal">Patrocinadores</p>
    <div class="marq marq-sp reveal">
    <ul class="spons">
      {event.sponsors.map((s) => (
        <li class="sp">
          {logo(s) && <img src={logo(s)} alt={symbolOnly(s) ? '' : s.name} loading="lazy" decoding="async" class={symbolOnly(s) ? 'sym' : ''} />}
          {(!logo(s) || symbolOnly(s)) && <span class="nm">{s.name}</span>}
          {s.role && <span class="role">{s.role}</span>}
        </li>
      ))}
    </ul>
    <ul class="spons dup" aria-hidden="true">
      {event.sponsors.map((s) => (
        <li class="sp">
          {logo(s) && <img src={logo(s)} alt="" loading="lazy" decoding="async" class={symbolOnly(s) ? 'sym' : ''} />}
          {(!logo(s) || symbolOnly(s)) && <span class="nm">{s.name}</span>}
          {s.role && <span class="role">{s.role}</span>}
        </li>
      ))}
    </ul>
    </div>

    <p class="label reveal">Parceiros</p>
    <div class="marq reveal">
      <ul class="parts">
        {event.partners.map((p) => (
          <li class="pt">
            {logo(p) ? <img src={logo(p)} alt={p.name} loading="lazy" decoding="async" /> : <span class="nm">{p.name}</span>}
            <span class="role">{p.role}</span>
          </li>
        ))}
      </ul>
      <ul class="parts dup" aria-hidden="true">
        {event.partners.map((p) => (
          <li class="pt">
            {logo(p) ? <img src={logo(p)} alt="" loading="lazy" decoding="async" /> : <span class="nm">{p.name}</span>}
            <span class="role">{p.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .label { margin-top: 32px; }
  .marq { margin-top: 16px; overflow: hidden; display: flex; gap: 16px; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .spons, .parts { list-style: none; margin: 0; padding: 0; display: flex; gap: 16px; flex: none; animation: marq 32s linear infinite; }
  .parts { animation-duration: 40s; }
  .marq:hover > ul { animation-play-state: paused; }
  @keyframes marq { from { transform: translateX(calc(-100% - 16px)); } to { transform: translateX(0); } }
  .sp { display: grid; place-items: center; align-content: center; gap: 8px; width: 260px; min-height: 150px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; text-align: center; background: var(--color-paper); }
  .sp img { max-width: 70%; max-height: 72px; width: auto; height: auto; object-fit: contain; }
  .sp img.sym { max-height: 44px; }
  .sp img.sym + .nm { font-size: 20px; }
  .sp .nm { font-weight: 800; font-size: 24px; letter-spacing: -0.01em; line-height: 1.1; }
  .role { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg2); }
  .pt { display: grid; place-items: center; align-content: center; gap: 6px; width: 200px; min-height: 120px; padding: 20px; border: 1px solid var(--line); border-radius: 16px; text-align: center; background: var(--color-paper); }
  .pt img { max-width: 70%; max-height: 48px; width: auto; height: auto; object-fit: contain; }
  .pt .nm { font-weight: 600; font-size: 18px; line-height: 1.15; }
  .pt .role { font-size: 11px; }
  @media (prefers-reduced-motion: reduce) { .spons, .parts { animation: none; } .marq { overflow-x: auto; mask-image: none; -webkit-mask-image: none; } .dup { display: none; } }
</style>
