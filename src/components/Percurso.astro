---
import event from '../data/event.json';
import { readGpx, projector, toPath, elevation, pointAt } from '../lib/route.js';
const d10 = event.distances.find((d) => d.id === '10k');
const d5 = event.distances.find((d) => d.id === '5k');
const r10 = readGpx(d10.gpx), r5 = readGpx(d5.gpx), ref = readGpx(d10.refGpx);
const W = 720, H = 300;
const proj = projector([r10, r5], W, H, 56);
const path10 = toPath(r10, proj), path5 = toPath(r5, proj);
const pins = event.route.points.map((p) => ({ ...p, ...proj(p) }));
// marcos: km na ida, posicionados sobre o eixo (primeiro trecho do 10 km, Bem Te Vi -> Anglo)
const marks = event.route.landmarks.filter((m) => m.km != null).map((m) => { const g = pointAt(r10, m.km * 1000); return { ...m, ...g, ...proj(g) }; });
const EW = 720, EH = 180;
const el = elevation(ref, EW, EH);
---
<section id="percurso" class="sec">
  <div class="wrap">
    <div class="sec-h reveal">
      <p class="eyebrow">Percurso</p>
      <h2>Vai e volta na Durval Nicolau. Largo, rápido e honesto.</h2>
      <p class="lede">{event.route.description}</p>
      <span class="badge">{event.route.status}</span>
    </div>

    <div class="toolbar reveal" role="group" aria-label="Escolher distância">
      <button type="button" class="seg on" data-show="10k" aria-pressed="true">10 km</button>
      <button type="button" class="seg" data-show="5k" aria-pressed="false">5 km</button>
      <span class="label hint">Toque nos pontos para ver os marcos</span>
    </div>

    <div class="map-wrap reveal" data-route data-active="10k" data-landmarks={JSON.stringify(marks.map((m) => ({ name: m.name, km: m.km, lat: +m.lat.toFixed(6), lon: +m.lon.toFixed(6) })))}>
      <div id="mapa" class="mapa" aria-label="Mapa do percurso" role="img"></div>
      <svg class="static" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Traçado do percurso: linha ao longo da avenida, com largada e chegada na Confraria Bem Te Vi">
        <path class="r r10" d={path10} fill="none" stroke="#0B1F3A" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <path class="r r5" d={path5} fill="none" stroke="#1B7A8C" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        {marks.map((m) => <circle class="mk" cx={m.x} cy={m.y} r="4" fill="#2ABFCC" stroke="#0B1F3A" stroke-width="1"><title>{`km ${m.km.toLocaleString('pt-BR')} · ${m.name}`}</title></circle>)}
        {pins.map((p) => (
          <g class="pin" data-for={p.dists.join(' ')}>
            <circle cx={p.x} cy={p.y} r="9" fill="#FDFBF7" stroke="#0B1F3A" stroke-width="3" />
            <text x={p.x} y={p.y - 16} text-anchor={p.x < 120 ? "start" : p.x > W - 120 ? "end" : "middle"} font-size="13" font-weight="600" fill="#0B1F3A">{p.label}</text>
          </g>
        ))}
      </svg>
      <a class="btn btn-ghost gmaps" href={event.venue.mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps</a>
    </div>

    <div class="facts reveal">
      <div><p class="label">Largada e chegada</p><p>Mesmo lugar, na porta da Confraria Bem Te Vi.</p></div>
      <div><p class="label">Contorno e retorno</p><p>Contorna na Brutal, em frente à Drogal, e retorna no Lions Clube, no Bedrock.</p></div>
      <div><p class="label">Voltas</p><p>O 5 km é uma volta. O 10 km são duas voltas no mesmo circuito.</p></div>
    </div>

    <figure class="elev reveal">
      <figcaption class="label">Perfil de elevação do 10 km · {d10.refNote}</figcaption>
      <svg viewBox={`0 0 ${EW} ${EH}`} role="img" aria-label={`Perfil de elevação, de ${el.min} a ${el.max} metros, em ${(el.total / 1000).toFixed(1)} km`}>
        <path d={el.area} fill="#1B7A8C" opacity=".14" />
        <path d={el.line} fill="none" stroke="#1B7A8C" stroke-width="2.5" stroke-linejoin="round" />
        <text x="4" y={el.yMax + 4} font-size="11" fill="#3A4A63" font-family="JetBrains Mono, monospace">{el.max}m</text>
        <text x="4" y={el.yMin + 4} font-size="11" fill="#3A4A63" font-family="JetBrains Mono, monospace">{el.min}m</text>
        {el.kms.map((k) => <text x={k.x} y={EH - 6} text-anchor="middle" font-size="11" fill="#3A4A63" font-family="JetBrains Mono, monospace">{k.km}</text>)}
        <text x={EW - 4} y={EH - 6} text-anchor="end" font-size="11" fill="#3A4A63" font-family="JetBrains Mono, monospace">km</text>
      </svg>
    </figure>

    <div class="marks reveal">
      <p class="label">Marcos no caminho, na ordem</p>
      <ol class="mono">{event.route.landmarks.map((m, i) => <li><span class="k">{m.km != null ? m.km.toLocaleString('pt-BR', { minimumFractionDigits: 1 }) : String(i + 1).padStart(2, '0')}</span>{m.name}</li>)}</ol>
    </div>
  </div>
</section>
<style>
  .sec-h .badge { justify-self: start; }
  .toolbar { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .seg { font: inherit; font-weight: 600; font-size: 15px; padding: 10px 18px; min-height: 44px; border-radius: 999px; border: 2px solid var(--line); background: none; color: var(--fg); cursor: pointer; }
  .seg.on { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-paper); }
  .hint { margin-left: auto; display: none; }
  .map-wrap { position: relative; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: var(--color-sand); }
  .mapa { display: none; height: 520px; }
  .mapa :global(.leaflet-tile-pane) { filter: saturate(.35) contrast(.95); }
  .static { display: block; width: 100%; height: auto; }
  .static .r5 { display: none; }
  [data-active="5k"] .static .r10 { display: none; }
  [data-active="5k"] .static .r5 { display: block; }
  [data-active="5k"] .static .pin[data-for="10k"] { display: none; }
  .gmaps { position: absolute; left: 16px; bottom: 16px; min-height: 44px; font-size: 14px; padding: 8px 16px; background: var(--color-paper); color: var(--color-navy); border-color: var(--color-navy); }
  .facts { display: grid; gap: 20px; margin-top: 32px; }
  .facts p + p { margin-top: 6px; }
  .elev { margin: 40px 0 0; }
  .elev svg { width: 100%; height: auto; display: block; margin-top: 12px; }
  .marks { margin-top: 32px; }
  .marks ol { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 24px; padding: 0; margin: 12px 0 0; font-size: 14px; color: var(--fg2); }
  .marks .k { color: var(--accent); margin-right: 8px; }
  @media (min-width: 820px) {
    .mapa { display: block; } .static, .gmaps { display: none; } .hint { display: block; }
    .facts { grid-template-columns: repeat(3, 1fr); }
  }
</style>
<script src="../scripts/mapa.js"></script>
