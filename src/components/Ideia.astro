---
import event from '../data/event.json';
import fotos from '../data/fotos2.json';
const a = fotos.avenida, b = fotos.verde;
const items = event.schedule;
---
<section id="ideia" class="sec">
  <div class="wrap">
    <div class="sec-h reveal">
      <p class="eyebrow">{event.ideia.eyebrow}</p>
      <h2>{event.ideia.title}</h2>
      <p class="lede">{event.ideia.lede}</p>
    </div>

    <div class="grid">
      <figure class="ph reveal"><img src="/img/fotos/avenida-800.webp" srcset="/img/fotos/avenida-480.webp 480w, /img/fotos/avenida-800.webp 800w, /img/fotos/avenida-1600.webp 1600w" sizes="(min-width: 820px) 30vw, 50vw" width={a.sizes['800'].w} height={a.sizes['800'].h} alt={a.alt} loading="lazy" decoding="async" /></figure>
      <figure class="ph reveal"><img src="/img/fotos/verde-800.webp" srcset="/img/fotos/verde-480.webp 480w, /img/fotos/verde-800.webp 800w, /img/fotos/verde-1600.webp 1600w" sizes="(min-width: 820px) 30vw, 50vw" width={b.sizes['800'].w} height={b.sizes['800'].h} alt={b.alt} loading="lazy" decoding="async" /></figure>
      <div class="sig reveal">
        <p class="label">Largada e chegada no mesmo lugar</p>
        <p class="sig-t">Quem corre fica. Quem veio junto também.</p>
      </div>
    </div>

    <div class="day reveal" data-timeline>
      <p class="label">O domingo, do começo ao fim</p>
      <ol class="tl">
        {items.map((s, i) => (
          <li style={`--i: ${i}`}>
            <span class="dot" aria-hidden="true"></span>
            <span class="t mono">{s.time === 'Tarde' ? 'TARDE' : s.time.replace(':', 'h')}</span>
            <span class="l">{s.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ph { margin: 0; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 5; border: 1px solid var(--line); }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sig { grid-column: 1 / -1; display: grid; gap: 10px; padding-top: 24px; }
  .sig-t { font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; line-height: 1.25; max-width: 560px; }
  @media (min-width: 820px) { .grid { grid-template-columns: 1fr 1fr 1.2fr; gap: 20px; align-items: end; } .sig { grid-column: auto; padding: 0 0 8px 24px; } }

  /* linha do tempo horizontal, desenha no scroll */
  .day { margin-top: 64px; }
  .tl { list-style: none; margin: 20px 0 0; padding: 0 0 8px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: 12px; overflow-x: auto; position: relative; scroll-snap-type: x proximity; }
  .tl::before { content: ""; position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: var(--line); }
  .tl::after { content: ""; position: absolute; left: 0; top: 7px; height: 2px; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); transition: transform 1.6s cubic-bezier(.2,.7,.2,1) .1s; }
  .day.in .tl::after { transform: scaleX(1); }
  .tl li { display: grid; gap: 8px; scroll-snap-align: start; opacity: 0; transform: translateY(8px); transition: opacity .5s ease calc(.15s + var(--i) * .16s), transform .5s ease calc(.15s + var(--i) * .16s); }
  .day.in .tl li { opacity: 1; transform: none; }
  .dot { width: 16px; height: 16px; border-radius: 50%; background: var(--color-paper); border: 3px solid var(--accent); }
  .t { font-weight: 600; color: var(--accent); font-size: 15px; letter-spacing: 0.06em; }
  .l { font-size: 15px; line-height: 1.35; color: var(--fg); }
  @media (min-width: 1100px) { .tl { grid-auto-columns: 1fr; overflow: visible; } }
  @media (prefers-reduced-motion: reduce) { .tl::after { transform: none; } .tl li { opacity: 1; transform: none; } }
</style>
