---
// A onda tripla do The Hybrid Club como divisor de seção. from/to: cor do bloco acima e abaixo.
const { from = 'navy', to = 'navy2' } = Astro.props;
const bg = { navy: '#0B1F3A', navy2: '#17213B', paper: '#FDFBF7', sand: '#F0EDE8' };
---
<div class="waves" aria-hidden="true" style={`background: linear-gradient(${bg[from]}, ${bg[from]} 50%, ${bg[to]} 50%, ${bg[to]})`}>
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" fill="none" stroke-linecap="round">
    <path d="M0 28 C180 4 360 60 540 30 S900 4 1080 30 S1350 60 1440 28" stroke="#2ABFCC" stroke-width="5" />
    <path d="M0 44 C160 32 340 60 520 46 S880 30 1060 46 S1340 62 1440 44" stroke="#4BA372" stroke-width="4" />
    <path d="M0 60 C200 60 380 44 560 44 S900 36 1080 26 S1340 14 1440 10" stroke="#1B7A8C" stroke-width="3.5" />
    <circle cx="1440" cy="28" r="6" fill="#2ABFCC" />
  </svg>
</div>
<style>
  .waves { height: 72px; }
  .waves svg { width: 100%; height: 100%; display: block; }
  @media (min-width: 820px) { .waves { height: 96px; } }
</style>
