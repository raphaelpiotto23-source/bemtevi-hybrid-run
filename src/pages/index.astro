import Capitaes from '../components/Capitaes.astro';
import Treinao from '../components/Treinao.astro';
import Ideia from '../components/Ideia.astro';
import Modalidades from '../components/Modalidades.astro';
import Percurso from '../components/Percurso.astro';
import Kit from '../components/Kit.astro';
import Programacao from '../components/Programacao.astro';
import Retirada from '../components/Retirada.astro';
import Bando from '../components/Bando.astro';
